{
  "name": "import-sync",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/import-sync"
  },
  "version": "2.2.6",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "tc": "jest --coverage",
    "lint": "biome lint",
    "format": "biome format",
