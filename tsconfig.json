{
  "extends": "./config/tsconfig.source.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "script/**/*.ts",
    "tests/**/*.ts",
    "commitlint.config.ts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
